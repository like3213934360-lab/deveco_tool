{
  "name": "deveco-tool",
  "version": "0.2.1",
  "private": false,
  "description": "Native HarmonyOS MCP with typed tools, deterministic LangGraph workflows and durable SQLite execution.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "bin": {
    "deveco-tool": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "resources/",
    "provenance/",
    "docs/",
    "README.md",
    "LICENSE",
    "NOTICE.*"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "node dist/src/cli.js mcp",
    "doctor": "node dist/src/cli.js doctor",
    "test": "npm run build && node dist/scripts/native-regression.js",
    "test:native": "npm test",
    "migration:audit": "node dist/scripts/native-migration-audit.js",
    "upstream:gate": "node dist/scripts/upstream-gate.js",
    "release:gate": "node dist/scripts/release-gate.js"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "0.6.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.10.0",
    "json5": "2.2.3",
    "koffi": "3.2.1",
    "vscode-jsonrpc": "8.2.1",
    "vscode-uri": "3.1.0",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "fast-uri": "3.1.7"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/yauzl": "3.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
