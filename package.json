{
  "name": "deveco-tool",
  "version": "0.1.0",
  "private": false,
  "description": "Local unified MCP gateway for DevEco Code skills and HarmonyOS diagnostics.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "deveco-tool": "src/cli.mjs"
  },
  "files": [
    "src/",
    "skills/",
    "docs/",
    "scripts/",
    "provenance/",
    "manifest.json",
    "PACK.md",
    "README.md",
    "LICENSE",
    "NOTICE.*"
  ],
  "scripts": {
    "mcp": "node src/server.mjs",
    "doctor": "node src/cli.mjs doctor",
    "scripts": "node src/cli.mjs scripts",
    "install-pack": "node scripts/install.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:device": "node --test --test-concurrency=1 test/device-canary.test.mjs",
    "test:flow:unit": "node --test --test-concurrency=1 test/arkpilot.test.mjs",
    "test:flow:device": "node scripts/arkpilot-device-test.mjs",
    "bench:ui-flow": "node scripts/arkpilot-benchmark.mjs",
    "bench:ui": "node --expose-gc scripts/ui-performance-benchmark.mjs",
    "build": "node --experimental-strip-types scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:native": "npm run build && node --test --test-reporter=spec dist/test/*.test.js"
  },
  "dependencies": {
    "@deveco-codegenie/mcp": "1.1.11",
    "@deveco/deveco-cli": "1.3.1",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "0.6.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.10.0",
    "json5": "2.2.3",
    "proper-lockfile": "4.1.2",
    "socket.io-client": "4.7.5",
    "vscode-jsonrpc": "8.2.1",
    "vscode-uri": "3.1.0",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/yauzl": "3.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
