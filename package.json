{
  "name": "deveco-mcp",
  "version": "1.3.3",
  "description": "Lean HarmonyOS MCP server: build, deploy, device UI, code intelligence and updatable knowledge packs for any MCP host.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "deveco-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "knowledge/",
    "templates/",
    "resources/",
    "README.md",
    "LICENSE",
    "NOTICE.*"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tools/build.mjs && node --test --test-concurrency=4 \"test/unit/*.test.mjs\"",
    "test:e2e": "node tools/build.mjs && node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "bench": "node tools/bench.mjs",
    "mcp": "node dist/cli.js mcp",
    "doctor": "node dist/cli.js doctor",
    "kb:build": "node dist/cli.js kb-build",
    "upstream:sync": "node tools/upstream-sync.mjs"
  },
  "dependencies": {
    "json5": "2.2.3",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@deveco-mcp/kb": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/yauzl": "3.4.0",
    "esbuild": "0.25.10",
    "typescript": "6.0.3"
  }
}
