{
  "name": "deveco-mcp",
  "version": "1.7.4",
  "description": "Lean HarmonyOS MCP server: build, deploy, device UI, code intelligence and updatable knowledge packs for any MCP host.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "deveco-mcp": "bin/deveco-mcp.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE.*"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node tools/build.mjs && node --test --test-concurrency=4 \"test/unit/*.test.mjs\" \"test/integration/*.test.mjs\"",
    "test:e2e": "node tools/build.mjs && node --test --test-concurrency=1 test/e2e/project.test.mjs",
    "bench": "node tools/bench.mjs",
    "mcp": "node bin/deveco-mcp.mjs mcp",
    "doctor": "node bin/deveco-mcp.mjs doctor",
    "kb:build": "node bin/deveco-mcp.mjs kb-build",
    "upstream:sync": "node tools/upstream-sync.mjs",
    "prepack": "node tools/prepack.mjs",
    "test:unit": "node --test --test-concurrency=4 \"test/unit/*.test.mjs\"",
    "test:integration": "node tools/build.mjs && node --test --test-concurrency=4 \"test/integration/*.test.mjs\"",
    "test:media": "node --test test/integration/media/recording.test.mjs",
    "test:cli-local": "node tools/build.mjs && node --test --test-concurrency=1 test/integration/cli-local.test.mjs",
    "test:lsp": "node tools/build.mjs && node --test --test-concurrency=1 test/e2e/lsp.test.mjs",
    "test:device-controls": "node tools/build.mjs && node --test --test-concurrency=1 --test-name-pattern=\"^device controls$\" test/e2e/device-controls.test.mjs",
    "test:emulator-controls": "node tools/build.mjs && node --test --test-concurrency=1 --test-name-pattern=\"^disposable emulator system controls$\" test/e2e/device-controls.test.mjs",
    "test:model": "node test/model/eval.mjs",
    "test:models": "node test/model/matrix.mjs",
    "test:model-report": "node test/model/report.mjs",
    "test:prompts": "node test/support/prompts.mjs",
    "test:recording": "node tools/build.mjs && node --test test/e2e/recording.test.mjs",
    "test:video": "node test/support/recording.mjs",
    "test:sdk": "node tools/build.mjs && node --test --test-concurrency=1 test/e2e/sdk.test.mjs",
    "test:device": "node tools/build.mjs && node --test --test-concurrency=1 test/e2e/device.test.mjs",
    "test:verify": "node tools/build.mjs && node --test --test-concurrency=1 test/e2e/verification.test.mjs test/e2e/baselines.test.mjs",
    "test:scenarios": "node tools/build.mjs && node --test --test-concurrency=1 test/e2e/scenario.test.mjs",
    "test:forms": "node tools/build.mjs && node --test --test-concurrency=1 test/e2e/form.test.mjs",
    "test:instrument-target": "node tools/build.mjs && node --test test/e2e/instrument-target.test.mjs",
    "test:fonts": "node tools/build.mjs && node --test test/e2e/font.test.mjs",
    "test:ui-selectors": "node tools/build.mjs && node --test --test-name-pattern=\"^UI query selectors\" test/e2e/ui.test.mjs",
    "test:build-signing": "node tools/build.mjs && node --test test/e2e/build-signing.test.mjs",
    "test:release-signing": "node tools/build.mjs && node --test --test-name-pattern=\"^release automatic signing$\" test/e2e/sign-cloud.test.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "json5": "2.2.3",
    "xpath": "0.0.35",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@deveco-mcp/kb": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/yauzl": "3.4.0",
    "esbuild": "0.25.10",
    "typescript": "6.0.3"
  }
}
