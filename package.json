{
  "name": "deveco-tool",
  "version": "0.1.0",
  "private": false,
  "description": "Local unified MCP gateway for DevEco Code skills and HarmonyOS diagnostics.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "deveco-tool": "src/cli.mjs"
  },
  "files": [
    "src/",
    "skills/",
    "docs/",
    "scripts/",
    "provenance/",
    "manifest.json",
    "PACK.md",
    "README.md",
    "LICENSE",
    "NOTICE.*"
  ],
  "scripts": {
    "mcp": "node src/server.mjs",
    "doctor": "node src/cli.mjs doctor",
    "scripts": "node src/cli.mjs scripts",
    "install-pack": "node scripts/install.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:device": "node --test --test-concurrency=1 test/device-canary.test.mjs",
    "test:flow:unit": "node --test --test-concurrency=1 test/arkpilot.test.mjs",
    "test:flow:device": "node scripts/arkpilot-device-test.mjs",
    "bench:ui-flow": "node scripts/arkpilot-benchmark.mjs"
  },
  "dependencies": {
    "@deveco-codegenie/mcp": "1.1.11",
    "@deveco/deveco-cli": "1.3.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "json5": "2.2.3",
    "vscode-jsonrpc": "8.2.1",
    "vscode-uri": "3.1.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "qs": "6.16.0"
  }
}
