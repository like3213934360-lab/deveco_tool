{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": true
  },
  "include": [
    "support/mcp.mjs",
    "support/recording.mjs",
    "support/prompts.mjs",
    "model/capture.mjs"
  ]
}
