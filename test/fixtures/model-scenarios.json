[
  {"id":"environment","goal":"不知道本机鸿蒙工具链、SDK 和登录是否就绪，先检查环境。","expect":[{"tool":"doctor"}]},
  {"id":"project-types","goal":"在 /workspace/Demo 新建 Demo 工程，包名 com.example.demo，同时支持手机和平板。","expect":[{"tool":"project","arguments":{"action":"create","device_types":["phone","tablet"]}}]},
  {"id":"build","goal":"刚改好 /workspace/Demo 的页面，检查并构建它，避免重复静态检查。","expect":[{"tool":"project","arguments":{"action":"build"}}],"forbid":[{"tool":"code","arguments":{"action":"check"}}]},
  {"id":"deploy-flow","goal":"将 /workspace/Demo 的修改构建并部署到已指定的 device-1，启动后回到保存的 checkout 页面路径。","expect":[{"tool":"run","arguments":{"action":"build_run","target":"device-1","then_flow":"checkout"}}]},
  {"id":"wait","goal":"构建返回任务 j_example，状态 running。继续等结果，不要重新发起构建。","expect":[{"tool":"job","arguments":{"action":"wait","job_id":"j_example"}}],"forbid":[{"tool":"project","arguments":{"action":"build"}}]},
  {"id":"blocked-job","goal":"任务 j_example 返回 needs_input，尚未看过原因。先查看任务再决定如何恢复。","expect":[{"tool":"job","arguments":{"action":"status","job_id":"j_example"}}],"forbid":[{"tool":"job","arguments":{"action":"resume","force":true}}]},
  {"id":"artifact","goal":"摘要里的完整日志编号是 a_0123456789abcdef。读取包含 ERROR 的内容，每页最多 50 行。","expect":[{"tool":"job","arguments":{"action":"read","artifact_id":"a_0123456789abcdef","grep":"ERROR","limit":50}}]},
  {"id":"sdk-signature","goal":"核实 /workspace/Demo 中 entry/src/main/ets/pages/Index.ets 使用的 router.pushUrl 在项目 SDK 中的精确声明，不能凭记忆。","expect":[{"tool":"code","arguments":{"action":"lsp","project":"/workspace/Demo","symbol":"router.pushUrl"}}],"one_of":[{"tool":"code","arguments":{"op":"hover"}},{"tool":"code","arguments":{"op":"definition"}}]},
  {"id":"api-compat","goal":"检查 /workspace/Demo 的 API 在不同 SDK 版本间是否兼容。","expect":[{"tool":"code","arguments":{"action":"api_scan"}}]},
  {"id":"device-log","goal":"查看 device-1 上 com.example.demo 最近五分钟包含 Error 的应用日志。","expect":[{"tool":"device","arguments":{"action":"log","target":"device-1","bundle":"com.example.demo","from":"5m","grep":"Error"}}]},
  {"id":"sqlite","goal":"只读查询 device-1 上 /data/local/tmp/demo.db 的 SELECT name FROM items LIMIT 5。","expect":[{"tool":"device","arguments":{"action":"sqlite","target":"device-1"}}]},
  {"id":"ui-batch","goal":"在 device-1 连续点击“设置”“关于”，最后验证“版本号”出现。尽量一次完成整条路径。","expect":[{"tool":"ui","arguments":{"action":"act","target":"device-1"}}],"require_fields":["steps","assert"]},
  {"id":"onboarding","goal":"device-1 上首次启动引导挡住页面，用户已授权使用默认选项完成引导，但上次操作后还没看当前屏幕。先查看当前控件，不要盲目重复。","expect":[{"tool":"ui","arguments":{"action":"observe","target":"device-1"}}]},
  {"id":"scroll-jank","goal":"量化 device-1 上 com.example.demo 的滚动流畅度、卡顿帧和内存占用。","expect":[{"tool":"ui","arguments":{"action":"perf","target":"device-1","bundle":"com.example.demo"}}]},
  {"id":"visual","goal":"将 device-1 的当前画面与名为 home 的截图基准比较，保留原基准。","expect":[{"tool":"ui","arguments":{"action":"visual","name":"home"}}],"forbid":[{"tool":"ui","arguments":{"action":"visual","update":true}}]},
  {"id":"layout","goal":"检查 device-1 当前页面是否有重叠、越界、过小点击区域和文字裁切。","expect":[{"tool":"ui","arguments":{"action":"layout","target":"device-1"}}]},
  {"id":"recording","goal":"开始录制 device-1 的屏幕，稍后结束时需要 MP4 文件。","expect":[{"tool":"ui","arguments":{"action":"record_start","target":"device-1"}}]},
  {"id":"test-session","goal":"为 device-1 上 com.example.demo 开始一轮有检查清单和报告的 UI 测试会话。","expect":[{"tool":"ui","arguments":{"action":"test_start"}}]},
  {"id":"replay","goal":"重放 /workspace/Demo 已保存的 checkout 界面操作路径，设备为 device-1。","expect":[{"tool":"ui_flow","arguments":{"action":"replay","project":"/workspace/Demo","id":"checkout","target":"device-1"}}]},
  {"id":"crash","goal":"分析 device-1 上 com.example.demo 最近一次崩溃，并映射到 /workspace/Demo 的源代码。","expect":[{"tool":"diagnose","arguments":{"action":"crash","target":"device-1","project":"/workspace/Demo"}}]},
  {"id":"knowledge","goal":"查找 ArkUI @Local 的官方说明；社区说法和项目 SDK 不一致时，以项目 SDK 与实际构建为准。","expect":[{"tool":"knowledge","arguments":{"action":"search"}}]},
  {"id":"knowledge-update","goal":"检查离线知识包有没有新版本，暂不下载或替换。","expect":[{"tool":"knowledge","arguments":{"action":"update","check":true}}]},
  {"id":"skills","goal":"查看内置的开发指导有哪些，暂不安装、导出或同步。","expect":[{"tool":"skills","arguments":{"action":"list"}}]},
  {"id":"cloud-login","goal":"我要登录用于华为云端知识检索的服务，打开登录流程。","expect":[{"tool":"auth","arguments":{"action":"login","provider":"codegenie"}}]},
  {"id":"signing","forbid_fields":["target"],"goal":"为 /workspace/Demo 自动配置调试签名，只有 device-1 一台设备连接，工程尚未配置签名，开发者服务已登录且只有一个团队。","expect":[{"tool":"sign","arguments":{"action":"auto","project":"/workspace/Demo"}}]},
  {"id":"snapshot","goal":"启动名为 Phone 的模拟器，必须恢复已有 Quick Boot 快照，固定 HDC 端口 5560，不能改成冷启动或其他端口。","expect":[],"forbid":[{"tool":"emulator","arguments":{"action":"start"}}],"notes_include":["10000","16555"]},
  {"id":"emulator-sensor","goal":"将已指定的模拟器 Phone 的电量设置为 25%。","expect":[{"tool":"emulator","arguments":{"action":"scenario","name":"Phone","scenario":"battery","level":25}}]},
  {"id":"manual-patch","goal":"/workspace/Demo 已在 device-1 以支持手动热修复的构建运行。只修改现有页面代码，现在应用一次手动补丁。","expect":[{"tool":"hot_reload","arguments":{"action":"apply","project":"/workspace/Demo","target":"device-1"}}]},
  {"id":"snapshot-valid","goal":"启动名为 Phone 的模拟器，必须恢复已有 Quick Boot 快照，固定 HDC 端口 15660，不能改成冷启动或其他端口。","expect":[{"tool":"emulator","arguments":{"action":"start","name":"Phone","boot_mode":"snapshot","hdc_port":15660}}]}
]
