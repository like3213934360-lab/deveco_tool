  {"id":"sign-package","goal":"用 /workspace/Demo 已有的签名配置对 /workspace/unsigned.hap 签名，输出 /workspace/signed.hap。","expect":[{"tool":"sign","arguments":{"action":"sign","project":"/workspace/Demo","file":"/workspace/unsigned.hap","out":"/workspace/signed.hap"}}]},
