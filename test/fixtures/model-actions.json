  {"id":"job-resume","goal":"已检查 j_example 中断原因并确认前一步未执行，现在从安全检查点恢复，不强制重跑不确定步骤。","expect":[{"tool":"job","arguments":{"action":"resume","job_id":"j_example"}}],"forbid":[{"tool":"job","arguments":{"force":true}}]},
  {"id":"code-check","goal":"只对 /workspace/Demo 的 entry/src/main/ets/pages/Index.ets 做快速 ArkTS 静态检查，不构建不修复。","expect":[{"tool":"code","arguments":{"action":"check","project":"/workspace/Demo","files":["entry/src/main/ets/pages/Index.ets"]}}],"forbid":[{"tool":"code","arguments":{"fix":true}}]},
  {"id":"code-lint","goal":"为 /workspace/Demo 运行 Code Linter，把报告保存到 /workspace/lint.json，不自动修复。","expect":[{"tool":"code","arguments":{"action":"lint","project":"/workspace/Demo","output_path":"/workspace/lint.json"}}],"forbid":[{"tool":"code","arguments":{"fix":true}}]},
  {"id":"code-versions","goal":"列出本机能用来做 API 兼容性比较的 SDK 版本。","expect":[{"tool":"code","arguments":{"action":"api_versions"}}]},
