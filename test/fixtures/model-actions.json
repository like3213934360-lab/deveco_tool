  {"id":"ui-screenshot","goal":"仅截取 device-1 当前画面，保存到 /workspace/screen.png，要求 PNG。","expect":[{"tool":"ui","arguments":{"action":"screenshot","target":"device-1","format":"png","save_path":"/workspace/screen.png"}}]},
