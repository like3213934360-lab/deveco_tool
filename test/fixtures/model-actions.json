  {"id":"sign-keypair","goal":"生成本地调试密钥库 /workspace/debug.p12，别名 debug，测试密码 Sample12345，暂不创建云端证书。","expect":[{"tool":"sign","arguments":{"action":"keypair","out":"/workspace/debug.p12","key_alias":"debug","keystore_password":"Sample12345"}}]},
