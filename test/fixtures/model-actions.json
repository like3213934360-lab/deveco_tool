[
  {"id":"project-info","goal":"只查看 /workspace/Demo 的 SDK、产品和模块信息。","expect":[{"tool":"project","arguments":{"action":"info","project":"/workspace/Demo"}}]},
  {"id":"project-sync","goal":"同步 /workspace/Demo 的 ohpm 依赖和 hvigor 工程配置，不构建。","expect":[{"tool":"project","arguments":{"action":"sync","project":"/workspace/Demo"}}]},
  {"id":"project-clean","goal":"清理 /workspace/Demo 的构建产物。","expect":[{"tool":"project","arguments":{"action":"clean","project":"/workspace/Demo"}}]},
  {"id":"run-deploy","goal":"把 /workspace/Demo 最近构建的包部署并启动在 device-1，不重新构建。","expect":[{"tool":"run","arguments":{"action":"deploy","project":"/workspace/Demo","target":"device-1"}}]},
  {"id":"run-launch","goal":"启动 device-1 上已经安装的 /workspace/Demo 应用，不构建、不安装。","expect":[{"tool":"run","arguments":{"action":"launch","project":"/workspace/Demo","target":"device-1"}}]},
