  {"id":"ui-review","goal":"测试会话 t_example 需要截图供视觉评审，要求是图标与标题垂直居中；此时还没看过截图，不能先给结论。","expect":[{"tool":"ui","arguments":{"action":"review","test_id":"t_example","requirement":"图标与标题垂直居中"}}],"forbid_fields":["outcome"]},
