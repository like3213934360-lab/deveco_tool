    "cli:cmd:ui screenshot": { "status": "full", "to": "ui action=screenshot" },
    "cli:cmd:ui screenshot:opt:--display": { "status": "full", "to": "ui display" },
    "cli:cmd:ui screenshot:opt:--path": { "status": "full", "to": "ui save_path" },
    "cli:cmd:ui screenrecord": { "status": "full", "to": "ui action=record_start action=record_stop" },
    "cli:cmd:ui screenrecord:opt:--path": { "status": "full", "to": "ui save_path" },
    "cli:cmd:ui screenrecord start": { "status": "full", "to": "ui action=record_start" },
    "cli:cmd:ui screenrecord start:opt:--path": { "status": "full", "to": "ui save_path" },
    "cli:cmd:ui screenrecord stop": { "status": "full", "to": "ui action=record_stop" },
