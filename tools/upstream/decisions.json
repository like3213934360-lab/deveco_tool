    "cli:cmd:ui window": { "status": "full", "to": "ui action=windows" },
    "cli:cmd:ui window list": { "status": "full", "to": "ui action=windows" },
    "cli:cmd:ui window list:opt:--all": { "status": "full", "to": "ui all" },

    "cli:cmd:update": { "status": "skip", "reason": "Self-update of the devecocli binary; this server is updated with git/npm." },
    "cli:cmd:update _check": { "status": "skip", "reason": "Internal background version check of devecocli." },
    "cli:cmd:docs update": { "status": "full", "to": "knowledge action=update" },
    "cli:cmd:docs update:opt:--check": { "status": "full", "to": "knowledge check" },
    "cli:cmd:docs update:opt:--force": { "status": "full", "to": "knowledge force" },

    "climcp:tool:check": { "status": "full", "to": "code action=check" },
    "climcp:tool:check:param:files": { "status": "full", "to": "code files" },
    "climcp:tool:check_cpp_files": { "status": "full", "to": "code action=check files" },
    "climcp:tool:check_cpp_files:param:files": { "status": "full", "to": "code files" },
    "climcp:tool:hover": { "status": "full", "to": "code op=hover" },
    "climcp:tool:definition": { "status": "full", "to": "code op=definition" },
