    "climcp:tool:documentSymbol:param:file": { "status": "full", "to": "code file" },
    "climcp:tool:workspaceSymbol": { "status": "full", "to": "code op=workspace_symbols" },
    "climcp:tool:workspaceSymbol:param:query": { "status": "full", "to": "code query" },
