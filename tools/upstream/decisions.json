    "climcp:tool:callHierarchy:enum:direction=incoming": { "status": "full", "to": "code direction=incoming" },
    "climcp:tool:callHierarchy:enum:direction=outgoing": { "status": "full", "to": "code direction=outgoing" },
    "climcp:tool:restart": { "status": "full", "to": "code action=lsp_restart" },
    "climcp:tool:restart:param:target": { "status": "full", "to": "code language" },
    "climcp:tool:restart:enum:target=arkts": { "status": "full", "to": "code language=arkts" },
    "climcp:tool:restart:enum:target=cpp": { "status": "full", "to": "code language=cpp" },
    "climcp:tool:restart:enum:target=all": { "status": "full", "to": "code language=all" }
  },
  "rules": [
    { "match": "code:tool:apply_patch*", "status": "host", "reason": "File editing is a host capability." },
    { "match": "code:tool:bash*", "status": "host", "reason": "Shell is a host capability." },
    { "match": "code:tool:edit*", "status": "host", "reason": "File editing is a host capability." },
    { "match": "code:tool:write*", "status": "host", "reason": "File writing is a host capability." },
    { "match": "code:tool:read*", "status": "host", "reason": "File reading is a host capability." },
    { "match": "code:tool:glob*", "status": "host", "reason": "File search is a host capability." },
    { "match": "code:tool:grep*", "status": "host", "reason": "Text search is a host capability." },
    { "match": "code:tool:task*", "status": "host", "reason": "Subagents are a host capability." },
    { "match": "code:tool:todowrite*", "status": "host", "reason": "Todo lists are a host capability." },
    { "match": "code:tool:question*", "status": "host", "reason": "Asking the user is a host capability." },
    { "match": "code:tool:plan_*", "status": "host", "reason": "Plan mode is a host capability." },
    { "match": "code:tool:webfetch*", "status": "host", "reason": "Web fetch is a host capability." },
    { "match": "code:tool:websearch*", "status": "host", "reason": "Web search is a host capability." },
    { "match": "code:tool:invalid*", "status": "host", "reason": "Internal error-recovery tool of the upstream agent." },
    { "match": "code:tool:debug_exit*", "status": "host", "reason": "Exits the upstream agent's debug mode; host agent control." },
    { "match": "code:agent:*", "status": "host", "reason": "Agent modes (build/plan/debug/explore/...) are host-level features." },
    { "match": "code:tool:spec_write*", "status": "skip", "reason": "Spec-driven workflow is served by the host's own plan mode; spec files are ordinary host file writes (user decision)." },
    { "match": "code:spec:*", "status": "skip", "reason": "Spec-driven prompts for DevEco Code's own agent; hosts' plan mode covers the workflow (user decision)." },
    { "match": "*:opt:--format", "status": "skip", "reason": "Human table/text formatting; MCP responses are always structured JSON." },
    { "match": "*:choice:--format=*", "status": "skip", "reason": "Human table/text formatting; MCP responses are always structured JSON." },
    { "match": "cli:cmd:*:opt:--device", "status": "full", "to": "device target" },
    { "match": "cli:cmd:emulator *:opt:--target", "status": "full", "to": "emulator name" },
    { "match": "cli:cmd:ui *:arg:x", "status": "full", "to": "ui x" },
    { "match": "cli:cmd:ui *:arg:y", "status": "full", "to": "ui y" },
    { "match": "cli:cmd:ui *:arg:x1", "status": "full", "to": "ui x" },
    { "match": "cli:cmd:ui *:arg:y1", "status": "full", "to": "ui y" },
    { "match": "cli:cmd:ui *:arg:x2", "status": "full", "to": "ui x2" },
    { "match": "cli:cmd:ui *:arg:y2", "status": "full", "to": "ui y2" },
    { "match": "cli:cmd:ui *:opt:--speed", "status": "full", "to": "ui speed" },
    { "match": "cli:cmd:ui *:opt:--id", "status": "full", "to": "ui selector" },
    { "match": "cli:cmd:ui *:opt:--window", "status": "full", "to": "ui window" },
    { "match": "climcp:tool:*:param:file", "status": "full", "to": "code file" },
    { "match": "climcp:tool:*:param:line", "status": "full", "to": "code line" },
    { "match": "climcp:tool:*:param:character", "status": "full", "to": "code column" }
  ]
}
